# Public site identity
NEXT_PUBLIC_SITE_URL=https://txdxnet.com

# Payload must only connect from the server. For local development use the
# Supabase session pooler (port 5432). Use transaction mode (6543) on Vercel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Development only. Use reviewed migrations before production deployments.
PAYLOAD_DB_PUSH=false

# Supabase Storage S3 configuration. Generate server-only access keys in
# Project Settings > Storage > S3 Configuration.
S3_BUCKET=media
S3_ENDPOINT=https://qfwekssxqjweujyijyyo.storage.supabase.co/storage/v1/s3
S3_REGION=ca-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
